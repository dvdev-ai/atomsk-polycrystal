unfix           eq

variable        L0 equal lx
print           "L0=${L0} T=${T} material=${material}"
L0=60.2339249859672 T=300 material=Cu

reset_timestep  0
fix             1 all npt temp ${T} ${T} 0.1 y 0 0 1 z 0 0 1 drag 1.0
fix             1 all npt temp 300 ${T} 0.1 y 0 0 1 z 0 0 1 drag 1.0
fix             1 all npt temp 300 300 0.1 y 0 0 1 z 0 0 1 drag 1.0
variable        erate equal 1.0e9
variable        erate_ps equal "v_erate/1.0e12"
fix             2 all deform 1 x erate ${erate_ps} units box remap x
fix             2 all deform 1 x erate 0.001 units box remap x

variable        strain equal "(lx - v_L0)/v_L0"
variable        sxx equal "-pxx/10000"
variable        syy equal "-pyy/10000"
variable        szz equal "-pzz/10000"
fix             out all print 200 "${strain} ${sxx} ${syy} ${szz}" file stress_strain.dat screen no

dump            1 all custom 2000 dump_tension.lammpstrj id type x y z
dump_modify     1 element ${elem} sort id
dump_modify     1 element Cu sort id

thermo          500
thermo_style    custom step v_strain temp press pxx pyy pzz ke pe
run             5000
