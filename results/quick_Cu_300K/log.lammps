variable        T equal ${temp}
variable        T equal 300
velocity        all create ${T} 492845 rot yes dist gaussian
velocity        all create 300 492845 rot yes dist gaussian

fix             eq all npt temp ${T} ${T} 0.1 iso 0 0 1
fix             eq all npt temp 300 ${T} 0.1 iso 0 0 1
fix             eq all npt temp 300 300 0.1 iso 0 0 1
thermo          500
thermo_style    custom step temp pe press lx ly lz
run             2000
